+'use client'
+
+import { useState } from 'react'
+import Image from 'next/image'
+import type { Event } from '@/lib/data'
+
+const FILTERS: { label: string; value: Event['type'] | 'all' }[] = [
+  { label: 'All', value: 'all' },
+  { label: 'Summits', value: 'summit' },
+  { label: 'Workshops', value: 'workshop' },
+  { label: 'Networking', value: 'networking' },
+  { label: 'Pitch Nights', value: 'pitch' },
+  { label: 'Virtual', value: 'virtual' },
+]
+
+const TAG_CLASS: Record<Event['type'], string> = {
+  summit: 'tag-summit',
+  workshop: 'tag-workshop',
+  networking: 'tag-networking',
+  pitch: 'tag-pitch',
+  virtual: 'tag-virtual',
+}
+
+const TAG_LABEL: Record<Event['type'], string> = {
+  summit: 'Summit',
+  workshop: 'Workshop',
+  networking: 'Networking',
+  pitch: 'Pitch Night',
+  virtual: 'Virtual',
+}
+
+const CalendarIcon = () => (
+  <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
+    <rect x="1" y="2" width="12" height="11" rx="2" stroke="currentColor" strokeWidth="1.4" />
+    <path d="M1 6h12" stroke="currentColor" strokeWidth="1.4" />
+    <path d="M4 1v2M10 1v2" stroke="currentColor" strokeWidth="1.4" strokeLinecap="round" />
+  </svg>
+)
+
+const PinIcon = () => (
+  <svg width="12" height="14" viewBox="0 0 11 14" fill="none">
+    <path d="M5.5 1C3.015 1 1 3.015 1 5.5c0 3.5 4.5 8.5 4.5 8.5s4.5-5 4.5-8.5C10 3.015 7.985 1 5.5 1Z" stroke="currentColor" strokeWidth="1.3" />
+    <circle cx="5.5" cy="5.5" r="1.5" stroke="currentColor" strokeWidth="1.3" />
+  </svg>
+)
+
+export default function EventsFilter({ events }: { events: Event[] }) {
+  const [active, setActive] = useState<Event['type'] | 'all'>('all')
+
+  const filtered = active === 'all' ? events : events.filter((e) => e.type === active)
+
+  return (
+    <>
+      <div className="filter-bar">
+        {FILTERS.map(({ label, value }) => (
+          <button
+            key={value}
+            className={`filter-btn${active === value ? ' active' : ''}`}
+            onClick={() => setActive(value)}
+          >
+            {label}
+          </button>
+        ))}
+      </div>
+
+      <section className="events-section">
+        <div className="events-section-label">Upcoming Events</div>
+        <div className="events-grid">
+          {filtered.map((event) => (
+            <div className="event-card" key={event.id}>
+              <div className="event-card-img">
+                <Image
+                  src={event.imageUrl}
+                  alt={event.title}
+                  width={400}
+                  height={180}
+                  style={{ width: '100%', height: '100%', objectFit: 'cover' }}
+                  unoptimized
+                />
+              </div>
+              <div className="event-card-body">
+                <span className={`event-type-tag ${TAG_CLASS[event.type]}`}>{TAG_LABEL[event.type]}</span>
+                <div className="event-title">{event.title}</div>
+                <div className="event-meta-row">
+                  <div className="event-meta-item">
+                    <CalendarIcon />
+                    {event.date}
+                  </div>
+                  <div className="event-meta-item">
+                    <PinIcon />
+                    {event.location}
+                  </div>
+                </div>
+                <div className="event-card-footer">
+                  {event.spotsLeft != null && (
+                    <span className="event-spots">{event.spotsLeft} spots left</span>
+                  )}
+                  <a href="#" className="event-register">Register →</a>
+                </div>
+              </div>
+            </div>
+          ))}
+        </div>
+      </section>
+    </>
+  )
+}
