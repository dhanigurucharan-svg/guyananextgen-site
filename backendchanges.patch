+const EMAIL_RE = /^[^\s@]+@[^\s@]+\.[^\s@]+$/
+
+// In-memory store for demonstration; replace with a database in production.
+const subscribers = new Set<string>()
+
+export async function POST(request: Request) {
+  let body: unknown
+  try {
+    body = await request.json()
+  } catch {
+    return Response.json({ error: 'Invalid JSON' }, { status: 400 })
+  }
+
+  if (typeof body !== 'object' || body === null || !('email' in body)) {
+    return Response.json({ error: 'Missing email field' }, { status: 400 })
+  }
+
+  const email = (body as Record<string, unknown>).email
+  if (typeof email !== 'string' || !EMAIL_RE.test(email)) {
+    return Response.json({ error: 'Invalid email address' }, { status: 422 })
+  }
+
+  const normalised = email.toLowerCase().trim()
+
+  if (subscribers.has(normalised)) {
+    return Response.json({ message: 'Already subscribed' }, { status: 200 })
+  }
+
+  subscribers.add(normalised)
+
+  return Response.json({ message: 'Subscribed successfully' }, { status: 201 })
+}
