+import { upcomingEvents, pastEvents } from '@/lib/data'
+import type { Event } from '@/lib/data'
+
+const VALID_TYPES: Event['type'][] = ['summit', 'workshop', 'networking', 'pitch', 'virtual']
+
+export async function GET(request: Request) {
+  const { searchParams } = new URL(request.url)
+  const type = searchParams.get('type') as Event['type'] | null
+
+  const filtered =
+    type && VALID_TYPES.includes(type)
+      ? upcomingEvents.filter((e) => e.type === type)
+      : upcomingEvents
+
+  return Response.json({
+    upcoming: filtered,
+    past: pastEvents,
+    featured: upcomingEvents.find((e) => e.featured) ?? null,
+    total: filtered.length,
+  })
+}
