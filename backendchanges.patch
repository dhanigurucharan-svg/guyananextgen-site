+}
+.story-row:hover .sr-headline { color: #2a7a50; }
+.sr-dek {
+  font-size: 13.5px; color: #3d4a43; line-height: 1.55;
+  margin-bottom: 10px;
+}
+.sr-foot {
+  font-size: 11px; color: rgba(20,32,26,0.45); letter-spacing: 0.04em;
+}
+.sr-foot strong { color: #14201a; font-weight: 500; }
+.sr-meta {
+  font-size: 10px; font-weight: 500; letter-spacing: 0.14em;
+  text-transform: uppercase; color: rgba(20,32,26,0.45);
+  white-space: nowrap; align-self: flex-start; padding-top: 4px;
+  font-family: 'Cormorant Garamond', serif; font-style: italic;
+}
+
+/* SIDEBAR */
+.sidebar { display: flex; flex-direction: column; gap: 40px; position: sticky; top: 156px; height: fit-content; }
+
+.side-card { background: transparent; padding: 0; }
+.side-h {
+  font-family: 'Cormorant Garamond', serif; font-size: 14px; font-weight: 700;
+  text-transform: uppercase; letter-spacing: 0.18em;
+  color: #14201a; padding-bottom: 12px;
+  border-bottom: 1px solid #14201a; margin-bottom: 4px;
+}
+
+/* MOST READ */
+.most-read .mr-item { display: flex; gap: 14px; padding: 14px 0; border-bottom: 1px solid rgba(20,32,26,0.1); align-items: baseline; }
+.most-read .mr-item:last-child { border-bottom: none; }
+.mr-num {
+  font-family: 'Cormorant Garamond', serif; font-style: italic;
+  font-size: 22px; font-weight: 600;
