+  padding-bottom: 12px;
+  border-bottom: 1px solid #14201a;
+  margin-bottom: 4px;
+  position: relative;
+}
+.sec-head::after {
+  content: ''; position: absolute; left: 0; bottom: -3px;
+  width: 90px; height: 3px;
+  background: linear-gradient(90deg, #2a7a50 0%, #2a7a50 100%);
+}
+
