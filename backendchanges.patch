+}
+
+/* PAST ISSUES */
+.past-strip {
+  padding: 60px 72px 80px;
+  border-top: 1px solid rgba(20,32,26,0.16);
+  position: relative;
+  background: linear-gradient(180deg, rgba(42,122,80,0.12) 0%, rgba(42,122,80,0) 60%);
+}
+.past-strip::before {
+  content: ''; position: absolute; left: 50%; top: -3px;
+  transform: translateX(-50%);
+  width: 160px; height: 5px;
+  background: linear-gradient(90deg, #2a7a50, #2a7a50, #2a7a50);
+}
+.past-strip-head { display: flex; align-items: baseline; gap: 14px; margin-bottom: 28px; padding-bottom: 12px; border-bottom: 1px solid #14201a; }
+.past-strip-h {
+  font-family: 'Cormorant Garamond', serif; font-size: 16px; font-weight: 700;
+  color: #14201a; text-transform: uppercase; letter-spacing: 0.16em;
+}
+.past-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 32px; }
+.past-item {
+  display: flex; flex-direction: column; gap: 8px; cursor: pointer;
+  padding-top: 14px; border-top: 1px solid rgba(20,32,26,0.16);
+}
+.past-num {
+  display: flex; justify-content: space-between;
+  font-size: 11px; letter-spacing: 0.08em;
+  color: rgba(20,32,26,0.5); font-family: 'Cormorant Garamond', serif; font-style: italic;
+}
+.past-date { color: rgba(20,32,26,0.4); }
+.past-headline {
+  font-family: 'Cormorant Garamond', serif; font-size: 16px; font-weight: 700;
+  color: #14201a; line-height: 1.2;
+}
+.past-item:hover .past-headline { color: #2a7a50; }
+
+@media (max-width: 1100px) {
+  .newsroom { grid-template-columns: 1fr; padding: 0 24px 80px; gap: 40px; }
+  .sidebar { position: static; }
+  .featured-wrapper { grid-template-columns: 1fr; max-width: 480px; margin: 0 auto 28px; gap: 16px; }
+  .featured-side.right { align-items: center; text-align: center; padding: 8px 0; order: 3; }
+  .featured-issue { order: 2; max-width: 100%; }
+  .bg-cursive { width: 460px; height: 460px; }
+}
+@media (max-width: 900px) {
+  .masthead, .strip, .container, .past-strip { padding-left: 24px; padding-right: 24px; }
+  .story-row { grid-template-columns: 100px 1fr; gap: 16px; }
+  .sr-thumb { width: 100px; }
+  .sr-meta { display: none; }
+  .past-grid { grid-template-columns: 1fr 1fr; }
+  .masthead-bottom { flex-direction: column; align-items: flex-start; gap: 16px; }
+  .masthead-stat { text-align: left; }
+}
